    deps = FUZZ_DEPS,
)

cc_binary(
    name = "mathopt-solve-standalone",
    srcs = [
        "asan_options.c",
        "fuzz_mathopt_solve.cc",
        "standalone_driver.c",
    ],
    deps = FUZZ_DEPS,
