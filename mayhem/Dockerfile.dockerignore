# BuildKit override for mayhem/Dockerfile — keeps .git (grader/PATCH tier need history).
# Prunes local build artifacts and non-source bulk from the or-tools tree.

# Bazel / native build outputs
bazel-*
bazel-out/
bazel-bin/
bazel-testlogs/
.bazel-output/
.bazel-tmp/
build/
out/
bin/
lib/
objs/
packages/
.cache/
dependencies/sources
dependencies/install
ortools/gen
build_cmake/
build_cross/
build_make/
install_make/
temp_*/
export/
export_meta/
classes/

# Upstream docker pruning (minus .git — must stay in context)
bazel/docs
bazel/README.md
bazel/cache
bazel/docker
bazel/Makefile
cmake/docs
cmake/README.md
cmake/cache
cmake/docker
cmake/Makefile
makefiles/docs
makefiles/README.md
makefiles/cache
makefiles/docker
makefiles/Makefile
Makefile.local
docs
tools/docker
tools/release
tools/win

# Editor / OS noise
.DS_Store
*.swp
*~
**/__pycache__/
*.o
*.a
*.so
*.dylib
